# REQUIRED on the Next.js server for Firebase-authenticated private database actions.
# Get this from Supabase Dashboard -> Project Settings -> API -> service_role.
# Never prefix this with NEXT_PUBLIC_ and never commit the actual value.
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Web App public configuration.
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
